# Superset Dockerfile for Unified Data Dashboard System
FROM apache/superset:latest

# Install additional packages
USER root
RUN pip install psycopg2-binary redis

# Copy our configuration
COPY superset_config.py /app/
COPY superset_init.sh /app/

# Set environment variable to use our config
ENV SUPERSET_CONFIG_PATH=/app/superset_config.py

# Create upload directory
RUN mkdir -p /app/uploads && chown -R superset:superset /app/uploads

# Switch to superset user
USER superset

# Run initialization script
ENTRYPOINT ["/app/superset_init.sh"]