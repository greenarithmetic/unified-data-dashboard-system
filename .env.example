# ===== DATABASE =====
DB_PASSWORD=your_secure_password_here_change_in_production
DATABASE_URL=postgresql://udds:${DB_PASSWORD}@postgres:5432/udds

# ===== REDIS =====
REDIS_URL=redis://redis:6379

# ===== GOOGLE SHEETS =====
# Получить credentials.json из https://console.cloud.google.com/
# GOOGLE_SHEETS_CREDENTIALS={"type": "service_account", "project_id": "your-project", ...}

# ===== SUPERSET =====
SUPERSET_SECRET_KEY=dev-secret-change-in-production
SUPERSET_DATABASE_PASSWORD=${DB_PASSWORD}

# ===== BACKEND =====
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8088"]
API_V1_STR=/api/v1

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== WEBHOOK SECURITY =====
WEBHOOK_SECRET=your-secret-for-webhook-validation

# ===== EXTERNAL API KEYS =====
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id